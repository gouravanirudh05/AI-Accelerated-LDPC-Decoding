// One SGT stage: SparseGTBPDecoder.refine() in sgt/sgt_decoder.py.
// Final config (README "Winner"): k = ceil(0.5 n) (k_min 8), d = 64, heads = 4, FF hidden 128,
// 2 transformer blocks, attn = "global" with Tanner-graph structure bias, select = "llr",
// fix = "residual", base = "prior". Shapes: B frames, n bits, m checks, E Tanner edges.
// Render: dot -Tsvg sgt_stage.dot -o sgt_stage.svg
digraph sgt_stage {
  rankdir=TB; nodesep=0.3; ranksep=0.35; compound=true;
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", shape=box, color="#555555"];
  edge [fontname="Helvetica", fontsize=9, color="#444444"];
  labelloc=t; fontname="Helvetica-Bold"; fontsize=15;
  label="One SGT stage (SparseGTBPDecoder.refine): stuck BP state → prior of the next BP run\n ";

  // ---------------- inputs ----------------
  subgraph cluster_in {
    label="Input: state of the BP run that did not converge"; fontsize=11; fontname="Helvetica-Bold";
    style="rounded,filled"; fillcolor="#eef4fc"; color="#9bb7dd";
    L    [label="L  [B, n]\nBP marginal LLR", fillcolor="#cfe3ff"];
    c2v  [label="c2v  [B, E]\ncheck → variable msgs", fillcolor="#cfe3ff"];
    llr  [label="llr  [B, n]\nchannel LLR", fillcolor="#cfe3ff"];
    prior[label="prior  [B, n]\nprior of that BP run", fillcolor="#cfe3ff"];
    H    [label="Tanner graph H  [m, n]\nVN degree, VN type", fillcolor="#e0e0e0"];
  }

  // ---------------- per-bit statistics ----------------
  subgraph cluster_stats {
    label="1. Per-bit statistics over all n bits (scatter over edges, O(E))"; fontsize=11; fontname="Helvetica-Bold";
    style="rounded,filled"; fillcolor="#fbf6ea"; color="#d8c27a";
    sgn   [label="s = sign(L)\nhard = (L < 0)", fillcolor="#fff4cc"];
    unsat [label="unsat = syndrome(hard)  [B, m]\nn_unsat = # unsatisfied checks per bit", fillcolor="#fff4cc"];
    msgs  [label="disagree = frac. of c2v with sign ≠ s\nsupport = mean s · tanh(c2v / 2)", fillcolor="#fff4cc"];
  }

  // ---------------- selection ----------------
  sel [label=<<b>2. Select k least-confident bits</b><br/>idx = top-k smallest |L|   [B, k]<br/>(k = ⌈0.5 n⌉; no gradient through idx)<br/><font point-size="9">select="unsat" variant: |L| / (1 + n_unsat)</font>>,
       fillcolor="#ffe0e0", color="#c0504d"];

  // ---------------- tokens ----------------
  subgraph cluster_tok {
    label="3. Tokens: one per selected bit, relative to its hard decision s"; fontsize=11; fontname="Helvetica-Bold";
    style="rounded,filled"; fillcolor="#fdf0e6"; color="#e0a370";
    feat [shape=box, style="filled", fillcolor="#ffffff", fontsize=9, label=<
      <table border="0" cellspacing="0" cellpadding="2">
      <tr><td colspan="2"><b>9 features  f  [B, k, 9]</b></td></tr>
      <tr><td align="left">1 s·L / 8</td><td align="left">6 disagree</td></tr>
      <tr><td align="left">2 s·llr / 8</td><td align="left">7 support</td></tr>
      <tr><td align="left">3 s·prior / 8</td><td align="left">8 frame syndrome weight</td></tr>
      <tr><td align="left">4 n_unsat / deg</td><td align="left">9 confidence rank / k</td></tr>
      <tr><td align="left">5 n_unsat / 4</td><td align="left">(1-3 clipped to ±5)</td></tr>
      </table>>];
    lin  [label="Linear 9 → d", fillcolor="#ffd9b3"];
    emb  [label="VN-type embedding → d\n(degree; 5G: base-graph column,\nso one model fits all lifting sizes)", fillcolor="#ffd9b3"];
    add  [label="+", shape=circle, style=filled, fillcolor="#ffffff", width=0.3, fixedsize=true];
    x0   [label="tokens x  [B, k, d=64]", fillcolor="#ffc89a"];
  }

  // ---------------- structure bias ----------------
  subgraph cluster_bias {
    label="4. Tanner-graph attention bias (O(k² m))"; fontsize=11; fontname="Helvetica-Bold";
    style="rounded,filled"; fillcolor="#f1ecf7"; color="#a58cc6";
    Hk    [label="H_k = Hᵀ[idx]  [B, k, m]", fillcolor="#e3d9f1"];
    shared[label="shared = H_k H_kᵀ  [B, k, k]\n# checks two selected bits share", fillcolor="#e3d9f1"];
    shu   [label="shared_unsat = (H_k ⊙ unsat) H_kᵀ\n# of those checks unsatisfied", fillcolor="#e3d9f1"];
    pb    [label="pair id = 4·min(shared,3) + min(shared_unsat,3)\n→ Embedding(16, heads) → bias  [B, 4, k, k]\n(zero-init; attn=\"local\": −∞ where shared = 0)", fillcolor="#d4c4ec"];
  }

  // ---------------- transformer ----------------
  subgraph cluster_tf {
    label="5. Sparse graph transformer over the k tokens only (block shown once; stacked × 2, pre-LN)"; fontsize=11; fontname="Helvetica-Bold";
    style="rounded,filled"; fillcolor="#eaf6ea"; color="#7fb77f";
    ln1  [label="LayerNorm", fillcolor="#cdeacd"];
    qkv  [label="Linear d → 3d  (Q, K, V; 4 heads × 16)", fillcolor="#cdeacd"];
    att  [label="softmax(QKᵀ/√16 + bias) V\nglobal: all k × k pairs", fillcolor="#a9dca9"];
    proj [label="Linear d → d", fillcolor="#cdeacd"];
    r1   [label="+", shape=circle, style=filled, fillcolor="#ffffff", width=0.3, fixedsize=true];
    ln2  [label="LayerNorm", fillcolor="#cdeacd"];
    ff   [label="FF: Linear d → 128, GELU, Linear 128 → d", fillcolor="#cdeacd"];
    r2   [label="+", shape=circle, style=filled, fillcolor="#ffffff", width=0.3, fixedsize=true];
  }

  // ---------------- head + fix ----------------
  subgraph cluster_out {
    label="6. Correction of the selected bits"; fontsize=11; fontname="Helvetica-Bold";
    style="rounded,filled"; fillcolor="#e8f5f3"; color="#6fb3a8";
    head [label="LayerNorm → Linear d → 1 (zero-init)\nδ = head(x) · s   [B, k]", fillcolor="#c5e8e2"];
    fix  [label="fix=\"residual\", base=\"prior\":\nprior'[idx] = prior[idx] + δ  (scatter at idx)\nother bits keep prior;  clamp to ±30", fillcolor="#c5e8e2"];
  }
  outp [label="prior'  [B, n]  → next BP(T) run", fillcolor="#e2f5e2", fontsize=11];

  // edges
  L -> sgn; H -> unsat [style=dashed]; sgn -> unsat; c2v -> msgs; sgn -> msgs;
  L -> sel;
  sel -> feat [label="gather idx"];
  unsat -> feat [lhead=cluster_tok]; msgs -> feat; llr -> feat; prior -> feat;
  feat -> lin -> add; emb -> add; add -> x0;
  sel -> Hk [label="idx"]; H -> Hk [style=dashed];
  Hk -> shared; Hk -> shu; unsat -> shu;
  shared -> pb; shu -> pb;
  x0 -> ln1 [lhead=cluster_tf];
  ln1 -> qkv -> att -> proj -> r1 -> ln2 -> ff -> r2;
  pb -> att [label="per-head bias", color="#7a5aa8", fontcolor="#7a5aa8"];
  x0 -> r1 [style=dotted, label="residual", constraint=false];
  r1 -> r2 [style=dotted, label="residual", constraint=false];
  r2 -> head [ltail=cluster_tf];
  head -> fix;
  fix -> outp;
}
